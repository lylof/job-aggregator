// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-py"
  interface = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Main job offers table
model Job {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  itemId             String    @unique @map("item_id")
  title              String    @db.VarChar(500)
  company            String    @db.VarChar(255)
  sourceUrl          String    @map("source_url") @db.Text
  sourceSite         String    @map("source_site") @db.VarChar(100)
  
  // Optional job details
  description        String?   @db.Text
  location           String?   @db.VarChar(255)
  salaryRange        String?   @map("salary_range") @db.VarChar(255)
  contractType       String?   @map("contract_type") @db.VarChar(100)
  experienceLevel    String?   @map("experience_level") @db.VarChar(255)
  educationLevel     String?   @map("education_level") @db.VarChar(255)
  sector             String?   @db.VarChar(255)
  
  // Job requirements and details
  missions           String[]  @db.Text
  requiredSkills     String[]  @map("required_skills") @db.Text
  profileDescription String?   @map("profile_description") @db.Text
  
  // Dates
  postedDate         DateTime? @map("posted_date") @db.Date
  applicationDeadline DateTime? @map("application_deadline") @db.Date
  
  // Contact information
  contactEmail       String?   @map("contact_email") @db.VarChar(255)
  contactPhone       String?   @map("contact_phone") @db.VarChar(50)
  
  // Extraction metadata
  extractionMethod   String    @map("extraction_method") @db.VarChar(50)
  extractionMetadata Json?     @map("extraction_metadata") @db.JsonB
  qualityScore       Float?    @map("quality_score") @db.Decimal(3, 2)
  
  // Raw data for debugging
  rawData            Json?     @map("raw_data") @db.JsonB
  
  // System fields
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz
  isActive           Boolean   @default(true) @map("is_active")
  
  @@index([sourceUrl])
  @@index([sourceSite])
  @@index([createdAt(sort: Desc)])
  @@index([postedDate(sort: Desc)])
  @@index([isActive])
  @@index([company])
  @@index([location])
  @@index([contractType])
  @@index([isActive, createdAt(sort: Desc)])
  @@index([sourceSite, isActive, createdAt(sort: Desc)])
  
  @@map("jobs")
}

// Scraping statistics table
model ScrapingStat {
  id                   String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sourceSite           String   @map("source_site") @db.VarChar(100)
  scrapeDate           DateTime @map("scrape_date") @db.Date
  urlsDiscovered       Int      @default(0) @map("urls_discovered")
  urlsProcessed        Int      @default(0) @map("urls_processed")
  jobsCreated          Int      @default(0) @map("jobs_created")
  jobsUpdated          Int      @default(0) @map("jobs_updated")
  successRate          Float?   @map("success_rate") @db.Decimal(5, 2)
  processingTimeSeconds Int?     @map("processing_time_seconds")
  errorsCount          Int      @default(0) @map("errors_count")
  errorDetails         Json?    @map("error_details") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  
  @@unique([sourceSite, scrapeDate])
  @@index([scrapeDate(sort: Desc)])
  @@index([sourceSite, scrapeDate(sort: Desc)])
  
  @@map("scraping_stats")
}